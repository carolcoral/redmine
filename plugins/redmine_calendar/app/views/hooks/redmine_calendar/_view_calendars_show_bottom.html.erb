<%= calendar_javascript_data(@project) %>

<%= javascript_include_tag('redmine_calendar_debug', plugin: 'redmine_calendar') %>

<script type="text/javascript">
// Initialize calendar enhancements when DOM is ready
$(document).ready(function() {
  console.log('Redmine Calendar Plugin: Initializing...');
  
  // Store calendar data in a global variable for JavaScript access
  if ($('#redmine-calendar-data').length) {
    window.redmineCalendarData = $('#redmine-calendar-data').data();
    console.log('Redmine Calendar Plugin: Data loaded', window.redmineCalendarData);
  }
  
  // Add calendar-day class and data-date attribute to date cells
  function initializeCalendarDays() {
    $('.calendar td').each(function() {
      var $td = $(this);
      
      // Skip if already initialized
      if ($td.hasClass('calendar-day')) return;
      
      // Find the day number element
      var $dayNumber = $td.find('.day-number');
      var dayText = $dayNumber.text().trim();
      
      // Find date from the link or cell content
      var date = null;
      
      // Try to get date from link href
      var $dayLink = $td.find('a');
      if ($dayLink.length && $dayLink.attr('href')) {
        var href = $dayLink.attr('href');
        var dateMatch = href.match(/(?:day|date)=([0-9]{4}-[0-9]{2}-[0-9]{2})/);
        if (dateMatch) {
          date = dateMatch[1];
        }
      }
      
      // If no date in href, try to construct from calendar context
      if (!date && window.redmineCalendarData && window.redmineCalendarData.projectId) {
        // This is a fallback - you may need to adjust based on your Redmine version
        var currentUrl = window.location.href;
        var urlDateMatch = currentUrl.match(/\?.*(?:month|date)=([0-9]{4})-([0-9]{2})/);
        if (urlDateMatch) {
          var year = urlDateMatch[1];
          var month = urlDateMatch[2];
          var day = dayText.padStart(2, '0');
          date = year + '-' + month + '-' + day;
        }
      }
      
      if (date) {
        $td.addClass('calendar-day');
        $td.attr('data-date', date);
        $td.css('cursor', 'pointer');
        console.log('Redmine Calendar Plugin: Initialized day cell', date);
      }
    });
  }
  
  // Initialize calendar days
  initializeCalendarDays();
  
  // Also initialize on calendar navigation (ajax complete)
  $(document).on('ajaxComplete', function() {
    setTimeout(initializeCalendarDays, 100);
  });
  
  // Make issue elements draggable and enhance them
  function initializeIssues() {
    $('.calendar .issue').each(function() {
      var $issue = $(this);
      
      // Skip if already initialized
      if ($issue.hasClass('calendar-issue')) return;
      
      var issueId = $issue.attr('id') ? $issue.attr('id').replace('issue-', '') : null;
      
      if (issueId) {
        $issue.addClass('calendar-issue');
        $issue.attr('data-issue-id', issueId);
        $issue.attr('draggable', 'true');
        
        // Add context menu if not exists
        if (!$issue.find('.calendar-issue-context-menu').length) {
          var contextMenuHtml = '<div class="calendar-issue-context-menu" style="display: none;" data-issue-id="' + issueId + '">';
          
          <% if User.current.logged? %>
            <% if User.current.allowed_to?(:edit_issues, @project || (@issue&.project)) %>
              contextMenuHtml += '<div class="context-menu-item" data-action="edit_assigned_to"><%= l(:button_change_assigned_to) %></div>';
              contextMenuHtml += '<div class="context-menu-item" data-action="edit_created_on"><%= l(:button_change_created_on) %></div>';
              contextMenuHtml += '<div class="context-menu-separator"></div>';
            <% end %>
            
            <% if User.current.allowed_to?(:delete_issues, @project || (@issue&.project)) %>
              contextMenuHtml += '<div class="context-menu-item" data-action="delete_issue"><%= l(:button_delete) %></div>';
            <% end %>
          <% end %>
          
          contextMenuHtml += '</div>';
          $issue.append(contextMenuHtml);
        }
        
        console.log('Redmine Calendar Plugin: Initialized issue', issueId);
      }
    });
  }
  
  // Initialize issues
  initializeIssues();
  
  // Also initialize on calendar navigation (ajax complete)
  $(document).on('ajaxComplete', function() {
    setTimeout(initializeIssues, 100);
  });
  
  console.log('Redmine Calendar Plugin: Initialization complete');
});
</script>

<style>
/* Ensure context menus are properly positioned */
.calendar-issue-context-menu {
  position: absolute;
  background: #fff;
  border: 1px solid #ddd;
  border-radius: 4px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  padding: 5px 0;
  min-width: 180px;
  z-index: 1000;
}

/* Hide context menus by default */
.calendar-issue-context-menu {
  display: none;
}

/* Add visual feedback for draggable areas */
.calendar .calendar-day {
  min-height: 80px;
  vertical-align: top;
}

/* Add visual feedback for draggable issues */
.calendar-issue {
  cursor: move;
  user-select: none;
}

.calendar-issue.dragging {
  opacity: 0.7;
}

.calendar .calendar-day.drag-over {
  background: #e3f2fd !important;
  border: 2px dashed #2196F3 !important;
}
</style>